<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="test/phpunit/integration-dolibarr/bootstrap.php"
         colors="true"
         verbose="true"
         stopOnFailure="false"
         cacheResult="true"
         executionOrder="defects"
         cacheResultFile=".phpunit.cache/integration-dolibarr-test-results.xml">

    <testsuites>
        <testsuite name="integration-dolibarr">
            <directory>test/phpunit/integration-dolibarr</directory>
        </testsuite>
    </testsuites>

    <!--
        Coverage is intentionally NOT declared here. Run
        "composer test:integration:coverage" to opt into a one-shot HTML/text
        report. Previous setup used processUncoveredFiles="true" which parsed
        the entire class/ and lib/ trees on every run, even when no coverage
        was needed.
    -->

    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="display_errors" value="On"/>
    </php>
</phpunit>
