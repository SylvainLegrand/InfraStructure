<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="test/phpunit/bootstrap.php"
         colors="true"
         verbose="true"
         stopOnFailure="false"
         cacheResult="true"
         executionOrder="defects"
         cacheResultFile=".phpunit.cache/test-results.xml">

    <testsuites>
        <testsuite name="unit">
            <directory>test/phpunit/unit</directory>
        </testsuite>
    </testsuites>

    <!--
        Coverage is intentionally NOT declared here: pcov instrumentation alone
        adds ~1s to the unit suite for ~300 tests, and coverage is rarely useful
        in the inner dev loop. Run "composer test:coverage" to opt into a
        one-shot HTML/text report.
    -->

    <php>
        <ini name="error_reporting" value="E_ALL"/>
        <ini name="display_errors" value="true"/>
    </php>
</phpunit>
